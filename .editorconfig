# EditorConfig — https://editorconfig.org
# Keeps whitespace consistent across editors so php-cs-fixer and prettier have
# nothing left to argue about.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,vue,scss,css,json,yml,yaml,twig,html}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{neon,dist.neon}]
indent_size = 4
