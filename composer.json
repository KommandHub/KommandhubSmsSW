{
    "name": "kommandhub/sms-sw",
    "description": "Transactional SMS for Shopware 6 with multi-provider routing for African networks (Termii, Sendexa, Africa's Talking, Twilio).",
    "type": "shopware-platform-plugin",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "keywords": [
        "shopware",
        "shopware6",
        "sms",
        "termii",
        "sendexa",
        "africastalking",
        "twilio",
        "africa"
    ],
    "homepage": "https://github.com/Kommandhub/KommandhubSmsSW",
    "authors": [
        {
            "name": "Kommandhub",
            "email": "info@kommandhub.com",
            "homepage": "https://kommandhub.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@kommandhub.com",
        "issues": "https://github.com/Kommandhub/KommandhubSmsSW/issues",
        "source": "https://github.com/Kommandhub/KommandhubSmsSW",
        "docs": "https://github.com/Kommandhub/KommandhubSmsSW/blob/main/README.md"
    },
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.6.0 || ~6.7.0",
        "shopware/storefront": "~6.6.0 || ~6.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "shopware/dev-tools": "^1.5",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "rregeer/phpunit-coverage-check": "^0.3.1"
    },
    "autoload": {
        "psr-4": {
            "Kommandhub\\SmsSW\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kommandhub\\SmsSW\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Kommandhub\\SmsSW\\KommandhubSmsSW",
        "label": {
            "en-GB": "SMS for Shopware 6",
            "de-DE": "SMS für Shopware 6",
            "fr-FR": "SMS pour Shopware 6"
        },
        "description": {
            "de-DE": "Transactional SMS for Shopware 6 with multi-provider routing for African networks (Termii, Sendexa, Africa's Talking, Twilio).",
            "en-GB": "Transactional SMS for Shopware 6 with multi-provider routing for African networks (Termii, Sendexa, Africa's Talking, Twilio).",
            "fr-FR": "Transactional SMS for Shopware 6 with multi-provider routing for African networks (Termii, Sendexa, Africa's Talking, Twilio)."
        },
        "manufacturerLink": {
            "de-DE": "https://kommandhub.com",
            "en-GB": "https://kommandhub.com"
        },
        "supportLink": {
            "de-DE": "https://kommandhub.com/support",
            "en-GB": "https://kommandhub.com/support"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
