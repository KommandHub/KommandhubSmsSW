parameters:
    paths:
        - 'src/'

    # shopware/storefront is a declared dependency (see composer.json); PHPStan
    # resolves Shopware\Storefront\* through the Composer autoloader. Do NOT add
    # a scanDirectories path into the host's vendor/ — it breaks in CI and in
    # shopware-cli, where the extension is analysed in an isolated directory.
    # Set the level to 9 (the highest level)
    level: 9

    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics

        # StringTemplateRenderer is marked @internal (becomes-internal in 6.8),
        # but it is the only sandboxed Twig-string renderer Shopware exposes and
        # core's own MailService depends on it exactly as we do. There is no
        # public replacement to migrate to, so this dependency is unavoidable
        # until Shopware ships one; scoped to this class only.
        - message: '#(deprecated|internal) class Shopware\\Core\\Framework\\Adapter\\Twig\\StringTemplateRenderer#'
          paths:
            - 'src/Flow/Action/SendSmsAction.php'
            - 'src/Notification/Service/TestMessageService.php'
          reportUnmatched: false

    parallel:
        jobSize: 20
        maximumNumberOfProcesses: 32
        minimumNumberOfJobsPerProcess: 2
